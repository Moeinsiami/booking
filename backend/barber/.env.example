# Django Core Settings Example
DJANGO_SECRET_KEY=generate_a_random_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase / PostgreSQL Database Configuration Example
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.[PROJECT_REF]
DB_PASSWORD=your_database_password
DB_HOST=aws-0-[REGION].pooler.supabase.com
DB_PORT=5432

# Zarinpal / Celery / cache (see api/zarinpal.py, barber/celery.py)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=http://localhost:3000/payment/verify
CELERY_BROKER_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/1
